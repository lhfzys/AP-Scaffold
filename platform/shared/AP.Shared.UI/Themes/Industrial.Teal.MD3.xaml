<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================
         语义颜色：状态 / 反馈
         ============================================================ -->
    <Color x:Key="Color.Success">#16A34A</Color>
    <Color x:Key="Color.OnSuccess">#FFFFFF</Color>

    <Color x:Key="Color.Warning">#D97706</Color>
    <Color x:Key="Color.OnWarning">#FFFFFF</Color>

    <Color x:Key="Color.Error">#DC2626</Color>
    <Color x:Key="Color.OnError">#FFFFFF</Color>

    <Color x:Key="Color.Info">#2563EB</Color>
    <Color x:Key="Color.OnInfo">#FFFFFF</Color>

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.OnSuccess" Color="{StaticResource Color.OnSuccess}"/>

    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.OnWarning" Color="{StaticResource Color.OnWarning}"/>

    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}"/>
    <SolidColorBrush x:Key="Brush.OnError" Color="{StaticResource Color.OnError}"/>

    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}"/>
    <SolidColorBrush x:Key="Brush.OnInfo" Color="{StaticResource Color.OnInfo}"/>

    <Color x:Key="Color.Inactive">#D1D5DB</Color>
    <SolidColorBrush x:Key="Brush.Inactive" Color="{StaticResource Color.Inactive}"/>

    <!-- ============================================================
         主色 / 次色 — 深蓝工业风 + 青蓝点缀
         ============================================================ -->
    <Color x:Key="Color.Primary">#1E3A5F</Color>
    <Color x:Key="Color.PrimaryLight">#2D5F8A</Color>
    <Color x:Key="Color.PrimaryDark">#0F2440</Color>

    <Color x:Key="Color.Accent">#0891B2</Color>
    <Color x:Key="Color.AccentLight">#22D3EE</Color>

    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}"/>
    <SolidColorBrush x:Key="Brush.PrimaryLight" Color="{StaticResource Color.PrimaryLight}"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.AccentLight" Color="{StaticResource Color.AccentLight}"/>

    <!-- 主色上的文字色（Raised 按钮前景等） -->
    <Color x:Key="Color.OnPrimary">#FFFFFF</Color>
    <SolidColorBrush x:Key="Brush.OnPrimary" Color="{StaticResource Color.OnPrimary}"/>

    <!-- 分隔线 / 边框（浅色主题下的中性描边） -->
    <Color x:Key="Color.Outline">#DDE2E8</Color>
    <SolidColorBrush x:Key="Brush.Outline" Color="{StaticResource Color.Outline}"/>

    <!-- ============================================================
         表面颜色 — 全浅色系统
         Surface         = 内容区纯白底
         SurfaceVariant  = 卡片 / 表格交替行浅灰
         SurfaceDark     = 侧边栏浅蓝灰底  ← 关键：不再是暗色
         ============================================================ -->
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceVariant">#F3F4F6</Color>
    <Color x:Key="Color.SurfaceDark">#E8EDF2</Color>
    <Color x:Key="Color.OnSurface">#111827</Color>
    <Color x:Key="Color.OnSurfaceVariant">#6B7280</Color>
    <Color x:Key="Color.OnSurfaceDark">#374151</Color>

    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.SurfaceVariant" Color="{StaticResource Color.SurfaceVariant}"/>
    <SolidColorBrush x:Key="Brush.SurfaceDark" Color="{StaticResource Color.SurfaceDark}"/>
    <SolidColorBrush x:Key="Brush.OnSurface" Color="{StaticResource Color.OnSurface}"/>
    <SolidColorBrush x:Key="Brush.OnSurfaceVariant" Color="{StaticResource Color.OnSurfaceVariant}"/>
    <SolidColorBrush x:Key="Brush.OnSurfaceDark" Color="{StaticResource Color.OnSurfaceDark}"/>

    <!-- 侧边栏选中态背景（浅蓝底 + 白字） -->
    <SolidColorBrush x:Key="Brush.Sidebar.Selected.Background" Color="#1E3A5F"/>
    <SolidColorBrush x:Key="Brush.Sidebar.Selected.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Sidebar.Hover.Background" Color="#D1DDE8"/>

    <!-- 遮罩层背景（Loading 等覆盖场景，半透明黑） -->
    <SolidColorBrush x:Key="Brush.Overlay.Background" Color="#80000000"/>

    <!-- ============================================================
         间距规模
         ============================================================ -->
    <system:Double x:Key="Layout.Spacing.Small">8</system:Double>
    <system:Double x:Key="Layout.Spacing.Medium">16</system:Double>
    <system:Double x:Key="Layout.Spacing.Large">24</system:Double>

    <GridLength x:Key="Layout.GridSpacing.Small">8</GridLength>
    <GridLength x:Key="Layout.GridSpacing.Medium">16</GridLength>
    <GridLength x:Key="Layout.GridSpacing.Large">24</GridLength>

    <!-- ============================================================
         圆角规模
         ============================================================ -->
    <CornerRadius x:Key="Layout.CornerRadius.Small">6</CornerRadius>
    <CornerRadius x:Key="Layout.CornerRadius.Medium">10</CornerRadius>
    <CornerRadius x:Key="Layout.CornerRadius.Large">16</CornerRadius>

    <!-- ============================================================
         阴影 / 海拔
         ============================================================ -->
    <system:Double x:Key="Layout.Elevation.Dp0">0</system:Double>
    <system:Double x:Key="Layout.Elevation.Dp1">1</system:Double>
    <system:Double x:Key="Layout.Elevation.Dp2">2</system:Double>
    <system:Double x:Key="Layout.Elevation.Dp4">4</system:Double>

    <!-- ============================================================
         字体规模（TextBlock 样式）
         ============================================================ -->
    <Style x:Key="TextStyle.Display" TargetType="TextBlock">
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LineHeight" Value="40"/>
    </Style>

    <Style x:Key="TextStyle.Headline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="32"/>
    </Style>

    <Style x:Key="TextStyle.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="28"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}"/>
    </Style>

    <Style x:Key="TextStyle.H6" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="24"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}"/>
    </Style>

    <Style x:Key="TextStyle.H5" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="26"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}"/>
    </Style>

    <Style x:Key="TextStyle.H4" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LineHeight" Value="36"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}"/>
    </Style>

    <Style x:Key="TextStyle.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>

    <Style x:Key="TextStyle.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="LineHeight" Value="16"/>
    </Style>

    <Style x:Key="TextStyle.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}"/>
    </Style>

    <!-- ============================================================
         通用尺寸
         ============================================================ -->
    <system:Double x:Key="Button.StandardHeight">38</system:Double>
    <system:Double x:Key="Button.SmallHeight">30</system:Double>
    <system:Double x:Key="TextBox.StandardHeight">38</system:Double>

    <!-- ============================================================
         DataGrid 行样式覆写
         ============================================================ -->
    <Style x:Key="MaterialDesignDataGridRow" TargetType="DataGridRow"
           BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Setter Property="Height" Value="44"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>