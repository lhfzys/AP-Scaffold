<UserControl x:Class="AP.Plugin.AuditLog.Views.AuditLogListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:audit="clr-namespace:AP.Contracts.Security.Audit;assembly=AP.Contracts.Security"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900"
              Background="Transparent">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏卡片 -->
        <md:Card Grid.Row="0"
                 Padding="16"
                 md:ElevationAssist.Elevation="Dp1"
                 Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="审计日志"
                           Style="{DynamicResource TextStyle.Title}"
                           VerticalAlignment="Center"
                           Margin="0,0,0,16"/>

                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                    <DatePicker SelectedDate="{Binding StartTime}"
                                md:HintAssist.Hint="开始时间"
                                Width="140"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"/>

                    <DatePicker SelectedDate="{Binding EndTime}"
                                md:HintAssist.Hint="结束时间"
                                Width="140"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"/>

                    <TextBox Text="{Binding SearchUserName, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="用户名"
                             Width="140"
                             Margin="0,0,12,0"
                             VerticalAlignment="Center"/>

                    <ComboBox ItemsSource="{Binding Source={x:Type audit:AuditActionType}, Mode=OneTime}"
                              SelectedItem="{Binding SelectedActionType}"
                              md:HintAssist.Hint="操作类型（留空表示全部）"
                              Width="160"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"/>

                    <Button Content="查询"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding SearchCommand}"
                            Height="{DynamicResource Button.StandardHeight}"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"/>

                    <Button Content="重置"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding ResetCommand}"
                            Height="{DynamicResource Button.StandardHeight}"
                            VerticalAlignment="Center"/>
                </WrapPanel>
            </Grid>
        </md:Card>

        <!-- 数据表格卡片 -->
        <md:Card Grid.Row="1"
                 Padding="0"
                 md:ElevationAssist.Elevation="Dp2">
            <DataGrid ItemsSource="{Binding Logs}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="{DynamicResource Brush.Surface}"
                      Foreground="{DynamicResource MaterialDesign.Brush.OnSurface}"
                      Style="{StaticResource MaterialDesignDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间"
                                        Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                        Width="140"/>
                    <DataGridTextColumn Header="用户"
                                        Binding="{Binding UserName}"
                                        Width="120"/>
                    <DataGridTextColumn Header="操作类型"
                                        Binding="{Binding ActionType}"
                                        Width="100"/>
                    <DataGridTextColumn Header="操作名称"
                                        Binding="{Binding ActionName}"
                                        Width="160"/>
                    <DataGridTextColumn Header="目标对象"
                                        Binding="{Binding TargetId}"
                                        Width="160"/>
                    <DataGridTextColumn Header="结果"
                                        Binding="{Binding Succeeded, Converter={StaticResource BoolToStatusConverter}}"
                                        Width="80"/>
                    <DataGridTextColumn Header="说明"
                                        Binding="{Binding Description}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </md:Card>

        <!-- 分页 -->
        <md:Card Grid.Row="2"
                 Padding="16"
                 md:ElevationAssist.Elevation="Dp2"
                 Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding PageInfo}"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="上一页"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CanGoPrevious}"
                        Height="{DynamicResource Button.StandardHeight}"
                        Margin="0,0,12,0"/>

                <Button Grid.Column="2"
                        Content="下一页"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoNext}"
                        Height="{DynamicResource Button.StandardHeight}"/>
            </Grid>
        </md:Card>

        <!-- 加载遮罩 -->
        <Grid Grid.Row="0"
              Grid.RowSpan="3"
              Background="{DynamicResource Brush.Surface}"
              Opacity="0.85"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             Value="0"
                             IsIndeterminate="True"
                             Width="50"
                             Height="50"/>
                <TextBlock Text="{Binding BusyText}"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           Style="{DynamicResource TextStyle.Body}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
