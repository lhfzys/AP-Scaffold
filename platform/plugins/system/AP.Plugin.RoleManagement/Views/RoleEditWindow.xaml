<Window x:Class="AP.Plugin.RoleManagement.Views.RoleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="560"
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.OnBackground}"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,0,0,1"
                Padding="24,18">
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Kind="ShieldAccount"
                             Width="24" Height="24"
                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                             VerticalAlignment="Center"
                             Margin="0,0,12,0"/>
                <TextBlock Text="{Binding Title}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 表单 -->
        <ScrollViewer Grid.Row="1" Margin="32,24">
            <StackPanel>
                <TextBox Text="{Binding RoleName, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="角色名称"
                         FontSize="14"
                         Margin="0,0,0,16"/>

                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="角色说明"
                         FontSize="14"
                         Margin="0,0,0,16"/>

                <TextBlock Text="权限"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="1"
                        Padding="8"
                        Margin="0,0,0,16">
                    <ScrollViewer MaxHeight="280"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AvailablePermissions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="{Binding GroupName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Permissions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Name}"
                                                              IsChecked="{Binding IsSelected}"
                                                              Margin="4"
                                                              FontSize="13"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource Brush.Surface}"
                Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消"
                        Style="{StaticResource MaterialDesignPaperButton}"
                        Command="{Binding CancelCommand}"
                        Height="{DynamicResource Button.StandardHeight}"
                        Margin="0,0,12,0"/>
                <Button Content="保存"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding SaveCommand}"
                        Height="{DynamicResource Button.StandardHeight}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
