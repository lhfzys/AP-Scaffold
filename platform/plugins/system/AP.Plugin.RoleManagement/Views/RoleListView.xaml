<UserControl x:Class="AP.Plugin.RoleManagement.Views.RoleListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ui="clr-namespace:AP.Shared.UI.Behaviors;assembly=AP.Shared.UI"
             xmlns:spinner="clr-namespace:AP.Shared.UI.Controls.LoadingSpinner;assembly=AP.Shared.UI"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900"
              Background="Transparent">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏卡片 -->
        <md:Card Grid.Row="0"
                 Padding="16"
                 md:ElevationAssist.Elevation="Dp1"
                 Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="角色管理"
                           Style="{DynamicResource TextStyle.Title}"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0"/>

                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="搜索角色名称或说明"
                         md:TextFieldAssist.HasLeadingIcon="True"
                         md:TextFieldAssist.LeadingIcon="Magnify"
                         Width="320"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignToolButton}"
                            Command="{Binding LoadRolesCommand}"
                            ToolTip="刷新"
                            Margin="0,0,8,0">
                        <md:PackIcon Kind="Refresh" Width="22" Height="22"/>
                    </Button>
                    <Button Content="新增"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding AddRoleCommand}"
                            Height="{DynamicResource Button.StandardHeight}"
                            Margin="0,0,8,0"
                            ui:PermissionBehavior.Permission="role.manage"
                            ui:PermissionBehavior.HideWhenUnauthorized="False"/>
                    <Button Content="编辑"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding EditRoleCommand}"
                            Height="{DynamicResource Button.StandardHeight}"
                            Margin="0,0,8,0"
                            ui:PermissionBehavior.Permission="role.manage"
                            ui:PermissionBehavior.HideWhenUnauthorized="False"/>
                    <Button Content="删除"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding DeleteRoleCommand}"
                            Height="{DynamicResource Button.StandardHeight}"
                            ui:PermissionBehavior.Permission="role.manage"
                            ui:PermissionBehavior.HideWhenUnauthorized="False"/>
                </StackPanel>
            </Grid>
        </md:Card>

        <!-- 数据表格卡片 -->
        <md:Card Grid.Row="1"
                 Padding="0"
                 md:ElevationAssist.Elevation="Dp2">
            <DataGrid ItemsSource="{Binding Roles}"
                      SelectedItem="{Binding SelectedRole}"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="角色名称"
                                        Binding="{Binding Name}"
                                        Width="200"/>
                    <DataGridTextColumn Header="说明"
                                        Binding="{Binding Description}"
                                        Width="300"/>
                    <DataGridTemplateColumn Header="权限" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Permissions}"
                                              Margin="0,4"
                                              VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource PrimaryHueLightBrush}"
                                                    CornerRadius="{DynamicResource Layout.CornerRadius.Small}"
                                                    Padding="6,2"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource MaterialDesign.Brush.OnSurface}"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </md:Card>

        <!-- 加载遮罩 -->
        <spinner:LoadingSpinner Grid.Row="0"
                                Grid.RowSpan="2"
                                IsLoading="{Binding IsBusy}"
                                LoadingText="{Binding BusyText}"/>
    </Grid>
</UserControl>
