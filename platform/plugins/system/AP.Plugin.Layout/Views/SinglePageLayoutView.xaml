<UserControl x:Class="AP.Plugin.Layout.Views.SinglePageLayoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AP.Plugin.Layout.Views"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:constants="clr-namespace:AP.Shared.Utilities.Constants;assembly=AP.Shared.Utilities"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <md:ColorZone
            Grid.Row="0"
            Padding="16"
            Panel.ZIndex="1"
            md:ElevationAssist.Elevation="Dp4"
            Mode="PrimaryMid">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <md:PackIcon
                        Width="32"
                        Height="32"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Kind="Gauge" />

                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Microsoft YaHei UI"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding SoftwareName}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <md:PackIcon
                        Width="20"
                        Height="20"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Kind="ClockTimeFourOutline"
                        Opacity="0.8" />

                    <TextBlock
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        FontFamily="Consolas, Microsoft YaHei"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{Binding CurrentTime}" />

                    <Border Background="{DynamicResource PrimaryHueDarkBrush}" 
                            CornerRadius="4" 
                            Padding="10,4" 
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="AccountCircle" 
                                         Width="18" Height="18"
                                         Foreground="White" 
                                         VerticalAlignment="Center" 
                                         Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding CurrentUserName}" 
                                       VerticalAlignment="Center" 
                                       FontSize="13"
                                       Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <Button
                        Padding="2"
                        Command="{Binding LogoutCommand}"
                        IsEnabled="{Binding CanLogout}"
                        Style="{StaticResource MaterialDesignToolForegroundButton}"
                        ToolTip="退出登录">
                        <md:PackIcon
                            Width="24"
                            Height="24"
                            Kind="Logout" />
                    </Button>

                    <Button
                        Padding="2"
                        Command="{Binding OpenSettingsCommand}"
                        Style="{StaticResource MaterialDesignToolForegroundButton}"
                        ToolTip="打开系统设置">
                        <md:PackIcon
                            Width="24"
                            Height="24"
                            Kind="Cog" />
                    </Button>
                </StackPanel>
            </Grid>
        </md:ColorZone>

        <ContentControl Grid.Row="1" prism:RegionManager.RegionName="{x:Static constants:GlobalConstants+RegionNames.ContentRegion}" />
    </Grid>
</UserControl>
