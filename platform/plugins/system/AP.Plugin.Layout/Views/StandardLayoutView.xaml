<UserControl x:Class="AP.Plugin.Layout.Views.StandardLayoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AP.Plugin.Layout.Views"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:constants="clr-namespace:AP.Shared.Utilities.Constants;assembly=AP.Shared.Utilities"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <md:DrawerHost x:Name="MainDrawerHost">
        <md:DrawerHost.RightDrawerContent>
            <Border Width="900" Background="{DynamicResource MaterialDesignPaper}">
                <ContentControl prism:RegionManager.RegionName="{x:Static constants:GlobalConstants+RegionNames.SettingsRegion}" />
            </Border>
        </md:DrawerHost.RightDrawerContent>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <md:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16" md:ElevationAssist.Elevation="Dp4" Panel.ZIndex="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <md:PackIcon Kind="Gauge" 
                                     Width="32" Height="32" 
                                     Foreground="White" 
                                     VerticalAlignment="Center" 
                                     Margin="0,0,12,0"/>

                        <TextBlock Text="{Binding SoftwareName}" 
                                   FontSize="22" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   VerticalAlignment="Center"
                                   FontFamily="Microsoft YaHei UI"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <md:PackIcon Kind="ClockTimeFourOutline" 
                                     Width="20" Height="20"
                                     Foreground="White" 
                                     Opacity="0.8"
                                     VerticalAlignment="Center" 
                                     Margin="0,0,8,0"/>

                        <TextBlock Text="{Binding CurrentTime}" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,16,0" 
                                   FontSize="18" 
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   FontFamily="Consolas, Microsoft YaHei"/>

                        <Button
                            Padding="2"
                            Command="{x:Static md:DrawerHost.OpenDrawerCommand}"
                            CommandParameter="{x:Static Dock.Right}"
                            Style="{StaticResource MaterialDesignToolForegroundButton}"
                            ToolTip="打开系统设置">
                            <md:PackIcon
                                Width="24"
                                Height="24"
                                Kind="Cog" />
                        </Button>
                    </StackPanel>
                </Grid>
            </md:ColorZone>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0">
                    <ContentControl prism:RegionManager.RegionName="{x:Static constants:GlobalConstants+RegionNames.SidebarRegion}" />
                </Border>

                <ContentControl Grid.Column="1" prism:RegionManager.RegionName="{x:Static constants:GlobalConstants+RegionNames.ContentRegion}" />
            </Grid>
        </Grid>
    </md:DrawerHost>
</UserControl>
