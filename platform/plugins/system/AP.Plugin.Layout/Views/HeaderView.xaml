<UserControl x:Class="AP.Plugin.Layout.Views.HeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <md:ColorZone Mode="PrimaryMid"
                  Padding="16,12"
                  md:ElevationAssist.Elevation="Dp4"
                  Panel.ZIndex="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧 Logo + 软件名 -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <md:PackIcon Kind="Gauge"
                             Width="32"
                             Height="32"
                             Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                             VerticalAlignment="Center"
                             Margin="0,0,12,0"/>

                <TextBlock Text="{Binding SoftwareName}"
                           Style="{DynamicResource TextStyle.Title}"
                           Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 右侧 时间 + 用户 + 设置 + 退出 -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0"
                            Opacity="0.9">
                    <md:PackIcon Kind="ClockTimeFourOutline"
                                 Width="18"
                                 Height="18"
                                 Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding CurrentTime}"
                               FontSize="14"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                               VerticalAlignment="Center"
                               FontFamily="Consolas, Microsoft YaHei"/>
                </StackPanel>

                <md:Chip Content="{Binding CurrentUserName}"
                         Icon="{md:PackIcon Kind=AccountCircle}"
                         Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                         Background="{DynamicResource PrimaryHueDarkBrush}"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"/>

                <Button Style="{StaticResource MaterialDesignToolForegroundButton}"
                        Command="{Binding LogoutCommand}"
                        IsEnabled="{Binding CanLogout}"
                        ToolTip="退出登录"
                        Padding="6">
                    <md:PackIcon Kind="Logout"
                                 Width="22"
                                 Height="22"
                                 Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"/>
                </Button>
            </StackPanel>
        </Grid>
    </md:ColorZone>
</UserControl>
