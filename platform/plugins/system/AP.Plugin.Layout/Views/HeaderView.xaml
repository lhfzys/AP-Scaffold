<UserControl x:Class="AP.Plugin.Layout.Views.HeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <md:ColorZone Mode="PrimaryMid"
                  Padding="16,12"
                  Height="56"
                  md:ElevationAssist.Elevation="Dp4"
                  Panel.ZIndex="1"
                  BorderThickness="0,0,0,1"
                  BorderBrush="{DynamicResource PrimaryHueDarkBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧 Logo + 软件名 -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <md:PackIcon Kind="Gauge"
                             Width="32"
                             Height="32"
                             Foreground="White"
                             VerticalAlignment="Center"
                             Margin="0,0,12,0"/>

                <TextBlock Text="{Binding SoftwareName}"
                           Style="{DynamicResource TextStyle.Title}"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 右侧 公司名（免登录时）+ 用户 + 退出 -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <!-- 免登录填充：公司名（登录模式下由用户区占据右侧，不显示） -->
                <TextBlock Text="{Binding CompanyName}"
                           FontSize="13"
                           Foreground="White"
                           Opacity="0.75"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"
                           Visibility="{Binding CanLogout, Converter={StaticResource InverseBoolToVis}}"/>

                <!-- 用户标识 + 退出登录（仅登录模式显示；CanLogout 即 Security:Enabled） -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding CanLogout, Converter={StaticResource BoolToVis}}">
                    <Border Background="{DynamicResource PrimaryHueDarkBrush}"
                            CornerRadius="16"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <md:PackIcon Kind="AccountCircle"
                                         Width="20"
                                         Height="20"
                                         Foreground="White"
                                         VerticalAlignment="Center"
                                         Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding CurrentUserName}"
                                       Foreground="White"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource MaterialDesignToolForegroundButton}"
                            Command="{Binding LogoutCommand}"
                            IsEnabled="{Binding CanLogout}"
                            ToolTip="退出登录"
                            Padding="6">
                        <md:PackIcon Kind="Logout"
                                     Width="22"
                                     Height="22"
                                     Foreground="White"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </md:ColorZone>
</UserControl>
