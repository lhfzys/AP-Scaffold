<UserControl x:Class="AP.Plugin.Layout.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <Grid Background="Transparent" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 欢迎区 -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Margin="0,0,0,4">
                    <Run Text="你好, " FontSize="24" FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.OnSurfaceVariant}"/>
                    <Run Text="{Binding DisplayName}" FontSize="24" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.OnSurface}"/>
                </TextBlock>
                <TextBlock Text="{Binding GreetingText}"
                           FontSize="14"
                           Foreground="{DynamicResource Brush.OnSurfaceVariant}"/>
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="{Binding CurrentDate}"
                       FontSize="13"
                       Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- KPI 卡片行 - 带彩色顶部色条 -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <!-- 活跃用户 -->
            <md:Card Width="200" Margin="0,0,16,16"
                     Padding="0"
                     md:ElevationAssist.Elevation="Dp1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource Brush.Primary}" CornerRadius="6,6,0,0"/>
                    <StackPanel Grid.Row="1" Margin="20,16,20,20">
                        <md:PackIcon Kind="AccountGroup" Width="28" Height="28"
                                     Foreground="{DynamicResource Brush.Primary}"/>
                        <TextBlock Text="活跃用户"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                                   Margin="0,10,0,4"/>
                        <TextBlock Text="{Binding ActiveUsers}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.OnSurface}"/>
                    </StackPanel>
                </Grid>
            </md:Card>

            <!-- 在线设备 -->
            <md:Card Width="200" Margin="0,0,16,16"
                     Padding="0"
                     md:ElevationAssist.Elevation="Dp1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource Brush.Accent}" CornerRadius="6,6,0,0"/>
                    <StackPanel Grid.Row="1" Margin="20,16,20,20">
                        <md:PackIcon Kind="Cog" Width="28" Height="28"
                                     Foreground="{DynamicResource Brush.Accent}"/>
                        <TextBlock Text="在线设备"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                                   Margin="0,10,0,4"/>
                        <TextBlock Text="{Binding OnlineDevices}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.OnSurface}"/>
                    </StackPanel>
                </Grid>
            </md:Card>

            <!-- 今日事件 -->
            <md:Card Width="200" Margin="0,0,16,16"
                     Padding="0"
                     md:ElevationAssist.Elevation="Dp1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource Brush.Info}" CornerRadius="6,6,0,0"/>
                    <StackPanel Grid.Row="1" Margin="20,16,20,20">
                        <md:PackIcon Kind="ChartBar" Width="28" Height="28"
                                     Foreground="{DynamicResource Brush.Info}"/>
                        <TextBlock Text="今日事件"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                                   Margin="0,10,0,4"/>
                        <TextBlock Text="{Binding TodayEvents}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.OnSurface}"/>
                    </StackPanel>
                </Grid>
            </md:Card>

            <!-- 系统运行时长 -->
            <md:Card Width="200" Margin="0,0,16,16"
                     Padding="0"
                     md:ElevationAssist.Elevation="Dp1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource Brush.Success}" CornerRadius="6,6,0,0"/>
                    <StackPanel Grid.Row="1" Margin="20,16,20,20">
                        <md:PackIcon Kind="ClockOutline" Width="28" Height="28"
                                     Foreground="{DynamicResource Brush.Success}"/>
                        <TextBlock Text="系统运行时长"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                                   Margin="0,10,0,4"/>
                        <TextBlock Text="{Binding Uptime}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.OnSurface}"/>
                    </StackPanel>
                </Grid>
            </md:Card>
        </WrapPanel>

        <!-- 下方两栏 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 快捷入口 - 图标按钮网格 -->
            <md:Card Grid.Column="0" Padding="24"
                     md:ElevationAssist.Elevation="Dp1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="快捷入口"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.OnSurface}"
                               Margin="0,0,0,20"/>

                    <UniformGrid Grid.Row="1" Columns="2" Rows="2">
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="RecipeListView"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="56" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="FileDocument" Width="20" Height="20"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="配方管理" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="ReportListView"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="56" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="ChartPie" Width="20" Height="20"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="报表中心" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="AuditLogListView"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="56" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="ClipboardText" Width="20" Height="20"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="审计日志" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="SettingsShellView"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="56">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Cog" Width="20" Height="20"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="系统设置" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Grid>
            </md:Card>

            <!-- 最近事件 - 去除深色嵌套背景 -->
            <md:Card Grid.Column="2" Padding="24"
                     md:ElevationAssist.Elevation="Dp1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="最近事件"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.OnSurface}"
                               Margin="0,0,0,20"/>

                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding RecentEvents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E5E7EB"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13" FontWeight="Medium"
                                                   Foreground="{DynamicResource Brush.OnSurface}"/>
                                        <TextBlock Text="{Binding TimestampText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </md:Card>
        </Grid>
    </Grid>
</UserControl>