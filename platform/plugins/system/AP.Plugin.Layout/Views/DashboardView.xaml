<UserControl x:Class="AP.Plugin.Layout.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <Grid Background="Transparent" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 欢迎区 -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Margin="0,0,0,4">
                    <Run Text="你好，" FontSize="24" FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.OnSurfaceVariant}"/>
                    <Run Text="{Binding DisplayName}" FontSize="24" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.OnSurface}"/>
                </TextBlock>
                <TextBlock Text="{Binding GreetingText}"
                           FontSize="14"
                           Foreground="{DynamicResource Brush.OnSurfaceVariant}"/>
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="{Binding CurrentDate}"
                       FontSize="13"
                       Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- 统计卡：大数字 + 右上圆角图标 + 底部状态徽标 -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 采集点 -->
            <md:Card Grid.Column="0" Margin="0,0,12,0"
                     Padding="20"
                     md:ElevationAssist.Elevation="Dp1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="采集点"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.OnSurfaceVariant}"/>
                        <TextBlock Text="{Binding AcquisitionPoints}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.OnSurface}"
                                   Margin="0,6,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AcquisitionBadgeText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding AcquisitionBadgeText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Inactive}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AcquisitionBadgeLevel}" Value="ok">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Success}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AcquisitionBadgeLevel}" Value="warn">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Warning}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AcquisitionBadgeLevel}" Value="err">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Error}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding AcquisitionBadgeText}"
                                       FontSize="11"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Inactive}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AcquisitionBadgeLevel}" Value="ok">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AcquisitionBadgeLevel}" Value="warn">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AcquisitionBadgeLevel}" Value="err">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Width="36" Height="36" VerticalAlignment="Top">
                        <Grid>
                            <Border Background="{DynamicResource Brush.Primary}" Opacity="0.12" CornerRadius="8"/>
                            <md:PackIcon Kind="Database" Width="18" Height="18"
                                         Foreground="{DynamicResource Brush.Primary}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </md:Card>

            <!-- 在线设备 -->
            <md:Card Grid.Column="1" Margin="0,0,12,0"
                     Padding="20"
                     md:ElevationAssist.Elevation="Dp1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="在线设备"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.OnSurfaceVariant}"/>
                        <TextBlock Margin="0,6,0,10">
                            <Run Text="{Binding OnlineDevices}" FontSize="28" FontWeight="Bold"
                                 Foreground="{DynamicResource Brush.OnSurface}"/>
                            <Run Text="{Binding OnlineDevicesSuffix}" FontSize="13"
                                 Foreground="{DynamicResource Brush.OnSurfaceVariant}"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OnlineBadgeText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OnlineBadgeText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Inactive}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OnlineBadgeLevel}" Value="ok">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Success}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OnlineBadgeLevel}" Value="warn">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Warning}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OnlineBadgeLevel}" Value="err">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Error}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding OnlineBadgeText}"
                                       FontSize="11"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Inactive}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OnlineBadgeLevel}" Value="ok">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OnlineBadgeLevel}" Value="warn">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OnlineBadgeLevel}" Value="err">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Width="36" Height="36" VerticalAlignment="Top">
                        <Grid>
                            <Border Background="{DynamicResource Brush.Accent}" Opacity="0.12" CornerRadius="8"/>
                            <md:PackIcon Kind="Monitor" Width="18" Height="18"
                                         Foreground="{DynamicResource Brush.Accent}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </md:Card>

            <!-- 今日变化 -->
            <md:Card Grid.Column="2" Margin="0,0,12,0"
                     Padding="20"
                     md:ElevationAssist.Elevation="Dp1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="今日变化"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.OnSurfaceVariant}"/>
                        <TextBlock Margin="0,6,0,10">
                            <Run Text="{Binding TagChanges}" FontSize="28" FontWeight="Bold"
                                 Foreground="{DynamicResource Brush.OnSurface}"/>
                            <Run Text=" 次" FontSize="13"
                                 Foreground="{DynamicResource Brush.OnSurfaceVariant}"/>
                        </TextBlock>
                    </StackPanel>
                    <Border Grid.Column="1" Width="36" Height="36" VerticalAlignment="Top">
                        <Grid>
                            <Border Background="{DynamicResource Brush.Info}" Opacity="0.12" CornerRadius="8"/>
                            <md:PackIcon Kind="LightningBolt" Width="18" Height="18"
                                         Foreground="{DynamicResource Brush.Info}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </md:Card>

            <!-- 系统运行时长 -->
            <md:Card Grid.Column="3"
                     Padding="20"
                     md:ElevationAssist.Elevation="Dp1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="系统运行时长"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.OnSurfaceVariant}"/>
                        <TextBlock Margin="0,6,0,10">
                            <Run Text="{Binding Uptime}" FontSize="28" FontWeight="Bold"
                                 Foreground="{DynamicResource Brush.OnSurface}"/>
                            <Run Text="{Binding UptimeSuffix}" FontSize="13"
                                 Foreground="{DynamicResource Brush.OnSurfaceVariant}"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UptimeBadgeText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding UptimeBadgeText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Inactive}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UptimeBadgeLevel}" Value="ok">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Success}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding UptimeBadgeLevel}" Value="warn">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Warning}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding UptimeBadgeLevel}" Value="err">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Error}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding UptimeBadgeText}"
                                       FontSize="11"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Inactive}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UptimeBadgeLevel}" Value="ok">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding UptimeBadgeLevel}" Value="warn">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding UptimeBadgeLevel}" Value="err">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Width="36" Height="36" VerticalAlignment="Top">
                        <Grid>
                            <Border Background="{DynamicResource Brush.Success}" Opacity="0.12" CornerRadius="8"/>
                            <md:PackIcon Kind="ClockOutline" Width="18" Height="18"
                                         Foreground="{DynamicResource Brush.Success}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </md:Card>
        </Grid>

        <!-- 第二行：实时趋势 + 最近事件 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 实时采集趋势（内存缓冲近 60 分钟；24H/7D/30D 待历史持久化） -->
            <md:Card Grid.Column="0" Margin="0,0,12,0"
                     Padding="24"
                     md:ElevationAssist.Elevation="Dp1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="实时采集趋势"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.OnSurface}"/>
                            <TextBlock Text="近 60 分钟数据变化"
                                       FontSize="11"
                                       Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                            <Border Background="{DynamicResource Brush.Primary}"
                                    CornerRadius="10" Padding="10,2" Margin="0,0,6,0">
                                <TextBlock Text="1H" FontSize="11"
                                           Foreground="{DynamicResource Brush.OnPrimary}"/>
                            </Border>
                            <Border Background="{DynamicResource Brush.SurfaceVariant}"
                                    CornerRadius="10" Padding="10,2" Margin="0,0,6,0"
                                    ToolTip="需历史数据持久化（未启用）">
                                <TextBlock Text="24H" FontSize="11"
                                           Foreground="{DynamicResource Brush.OnSurfaceVariant}"/>
                            </Border>
                            <Border Background="{DynamicResource Brush.SurfaceVariant}"
                                    CornerRadius="10" Padding="10,2" Margin="0,0,6,0"
                                    ToolTip="需历史数据持久化（未启用）">
                                <TextBlock Text="7D" FontSize="11"
                                           Foreground="{DynamicResource Brush.OnSurfaceVariant}"/>
                            </Border>
                            <Border Background="{DynamicResource Brush.SurfaceVariant}"
                                    CornerRadius="10" Padding="10,2"
                                    ToolTip="需历史数据持久化（未启用）">
                                <TextBlock Text="30D" FontSize="11"
                                           Foreground="{DynamicResource Brush.OnSurfaceVariant}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <lvc:CartesianChart Series="{Binding TrendSeries}"
                                            XAxes="{Binding TrendXAxes}"
                                            YAxes="{Binding TrendYAxes}"
                                            LegendPosition="Bottom"
                                            MinHeight="240"/>
                        <TextBlock Text="暂无数值型采集点"
                                   FontSize="13"
                                   Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasTrendSeries, Converter={StaticResource InverseBoolToVis}}"/>
                    </Grid>
                </Grid>
            </md:Card>

            <!-- 最近事件 -->
            <md:Card Grid.Column="1"
                     Padding="24"
                     md:ElevationAssist.Elevation="Dp1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="最近事件"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.OnSurface}"/>
                        <TextBlock Text="最新 10 条"
                                   FontSize="11"
                                   Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RecentEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.Outline}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0"
                                                     Width="8" Height="8"
                                                     VerticalAlignment="Top"
                                                     Margin="0,5,8,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Info}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="Success">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.Success}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.Warning}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.Error}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="13" FontWeight="Medium"
                                                           Foreground="{DynamicResource Brush.OnSurface}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding TimestampText}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding LevelText}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Info}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="Success">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </md:Card>
        </Grid>
    </Grid>
</UserControl>
