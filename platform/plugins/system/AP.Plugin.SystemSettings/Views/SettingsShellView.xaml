<UserControl x:Class="AP.Plugin.SystemSettings.Views.SettingsShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ui="clr-namespace:AP.Shared.UI.Behaviors;assembly=AP.Shared.UI"
             xmlns:spinner="clr-namespace:AP.Shared.UI.Controls.LoadingSpinner;assembly=AP.Shared.UI"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900"
             Margin="16"
             Background="Transparent">
    <md:Card Padding="0"
             md:ElevationAssist.Elevation="Dp2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部 Tab 切换 -->
            <TabControl Grid.Row="0"
                        Grid.RowSpan="2"
                        ItemsSource="{Binding Contributors}"
                        SelectedItem="{Binding SelectedContributor, Mode=TwoWay}"
                        Style="{StaticResource MaterialDesignTabControl}"
                        HorizontalAlignment="Left"
                        Margin="16,8,16,0">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}"
                                   FontSize="14"/>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <!-- 内边距放内容上（ScrollViewer.Padding 未必生效）；
                                 右侧 40 保证滚动条出现后仍与内容有约 26px 净距 -->
                            <ContentControl Content="{Binding Editor}" Margin="24,24,40,24"/>
                        </ScrollViewer>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <!-- 加载遮罩 -->
            <spinner:LoadingSpinner Grid.Row="0"
                                    Grid.RowSpan="3"
                                    IsLoading="{Binding IsBusy}"
                                    LoadingText="{Binding BusyText}"/>

            <!-- 底部操作栏 -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource Brush.Outline}"
                    BorderThickness="0,1,0,0"
                    Background="{DynamicResource Brush.Surface}"
                    Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消"
                            Style="{StaticResource MaterialDesignPaperButton}"
                            Command="{Binding CancelChangesCommand}"
                            Height="{DynamicResource Button.StandardHeight}"
                            Margin="0,0,12,0"/>
                    <Button Content="保存配置"
                            Style="{StaticResource RaisedButton.Primary}"
                            Command="{Binding SaveSettingsCommand}"
                            Height="{DynamicResource Button.StandardHeight}"
                            ui:PermissionBehavior.Permission="system.settings"
                            ui:PermissionBehavior.HideWhenUnauthorized="False"/>
                </StackPanel>
            </Border>
        </Grid>
    </md:Card>
</UserControl>
