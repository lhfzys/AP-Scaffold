<Window x:Class="AP.Plugin.Login.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:spinner="clr-namespace:AP.Shared.UI.Controls.LoadingSpinner;assembly=AP.Shared.UI"
        mc:Ignorable="d"
        Title="系统登录"
        Height="460"
        Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.OnBackground}"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <md:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="32,28">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <md:PackIcon Kind="ShieldAccount"
                             Width="36" Height="36"
                             Foreground="White"
                             VerticalAlignment="Center"
                             Margin="0,0,12,0"/>
                <TextBlock Text="系统登录"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </md:ColorZone>

        <!-- 登录表单 -->
        <StackPanel Grid.Row="1" Margin="40,32,40,32" VerticalAlignment="Center">
            <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                     md:HintAssist.Hint="用户名"
                     md:TextFieldAssist.HasLeadingIcon="True"
                     md:TextFieldAssist.LeadingIcon="Account"
                     FontSize="14"
                     Margin="0,0,0,20"/>

            <PasswordBox x:Name="PasswordBox"
                         md:HintAssist.Hint="密码"
                         md:TextFieldAssist.HasLeadingIcon="True"
                         md:TextFieldAssist.LeadingIcon="Lock"
                         FontSize="14"
                         Margin="0,0,0,8"
                         PasswordChanged="PasswordBox_PasswordChanged"
                         KeyDown="PasswordBox_KeyDown"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       MinHeight="20"
                       Margin="0,0,0,20"/>

            <Button Content="登录"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding LoginCommand}"
                    Height="{DynamicResource Button.StandardHeight}"
                    FontSize="14"
                    IsDefault="True"/>

            <Button Content="退出"
                    Style="{StaticResource MaterialDesignPaperButton}"
                    Command="{Binding CancelCommand}"
                    Height="{DynamicResource Button.StandardHeight}"
                    FontSize="14"
                    Margin="0,12,0,0"/>
        </StackPanel>

        <!-- 加载遮罩 -->
        <spinner:LoadingSpinner Grid.Row="0"
                                Grid.RowSpan="2"
                                IsLoading="{Binding IsBusy}"
                                LoadingText="{Binding BusyText}"/>
    </Grid>
</Window>
