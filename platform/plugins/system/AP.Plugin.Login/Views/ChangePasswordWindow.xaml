<Window x:Class="AP.Plugin.Login.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="修改密码"
        Height="520"
        Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.OnBackground}"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <md:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="32,28">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <md:PackIcon Kind="LockReset"
                             Width="32" Height="32"
                             Foreground="White"
                             VerticalAlignment="Center"
                             Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="首次登录，请修改密码"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="默认密码安全性较低，修改后才能继续使用"
                               FontSize="12"
                               Foreground="White"
                               Opacity="0.8"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </md:ColorZone>

        <!-- 改密表单 -->
        <StackPanel Grid.Row="1" Margin="40,32,40,32" VerticalAlignment="Center">
            <PasswordBox x:Name="CurrentPasswordBox"
                         md:HintAssist.Hint="当前密码"
                         md:TextFieldAssist.HasLeadingIcon="True"
                         md:TextFieldAssist.LeadingIcon="LockOpen"
                         FontSize="14"
                         Margin="0,0,0,16"
                         PasswordChanged="PasswordBox_PasswordChanged"/>

            <PasswordBox x:Name="NewPasswordBox"
                         md:HintAssist.Hint="新密码"
                         md:TextFieldAssist.HasLeadingIcon="True"
                         md:TextFieldAssist.LeadingIcon="Lock"
                         FontSize="14"
                         Margin="0,0,0,16"
                         PasswordChanged="PasswordBox_PasswordChanged"/>

            <PasswordBox x:Name="ConfirmPasswordBox"
                         md:HintAssist.Hint="确认新密码"
                         md:TextFieldAssist.HasLeadingIcon="True"
                         md:TextFieldAssist.LeadingIcon="LockCheck"
                         FontSize="14"
                         Margin="0,0,0,8"
                         PasswordChanged="PasswordBox_PasswordChanged"
                         KeyDown="ConfirmPasswordBox_KeyDown"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       MinHeight="20"
                       Margin="0,0,0,20"/>

            <Button Content="保存"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding ChangePasswordCommand}"
                    Height="{DynamicResource Button.StandardHeight}"
                    FontSize="14"
                    IsDefault="True"/>

            <Button Content="退出"
                    Style="{StaticResource MaterialDesignPaperButton}"
                    Command="{Binding CancelCommand}"
                    Height="{DynamicResource Button.StandardHeight}"
                    FontSize="14"
                    Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</Window>
