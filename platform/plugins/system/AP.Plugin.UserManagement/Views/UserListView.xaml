<UserControl x:Class="AP.Plugin.UserManagement.Views.UserListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource MaterialDesign.Brush.Background}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏卡片 -->
        <md:Card Grid.Row="0"
                 Padding="16"
                 md:ElevationAssist.Elevation="Dp2"
                 Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="用户管理"
                           Style="{DynamicResource TextStyle.Title}"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0"/>

                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="搜索用户名或显示名"
                         md:TextFieldAssist.HasLeadingIcon="True"
                         md:TextFieldAssist.LeadingIcon="Magnify"
                         Width="320"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignToolButton}"
                            Command="{Binding LoadUsersCommand}"
                            ToolTip="刷新"
                            Margin="0,0,8,0">
                        <md:PackIcon Kind="Refresh" Width="22" Height="22"/>
                    </Button>
                    <Button Content="新增"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding AddUserCommand}"
                            Height="{DynamicResource Button.StandardHeight}"
                            Margin="0,0,8,0"/>
                    <Button Content="编辑"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding EditUserCommand}"
                            Height="{DynamicResource Button.StandardHeight}"
                            Margin="0,0,8,0"/>
                    <Button Content="重置密码"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding ResetPasswordCommand}"
                            Height="{DynamicResource Button.StandardHeight}"
                            Margin="0,0,8,0"/>
                    <Button Content="删除"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding DeleteUserCommand}"
                            Height="{DynamicResource Button.StandardHeight}"/>
                </StackPanel>
            </Grid>
        </md:Card>

        <!-- 数据表格卡片 -->
        <md:Card Grid.Row="1"
                 Padding="0"
                 md:ElevationAssist.Elevation="Dp2">
            <DataGrid ItemsSource="{Binding Users}"
                      SelectedItem="{Binding SelectedUser}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="{DynamicResource Brush.Surface}"
                      Foreground="{DynamicResource MaterialDesign.Brush.OnSurface}"
                      Style="{StaticResource MaterialDesignDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="用户名"
                                        Binding="{Binding UserName}"
                                        Width="150"/>
                    <DataGridTextColumn Header="显示名"
                                        Binding="{Binding DisplayName}"
                                        Width="200"/>
                    <DataGridTemplateColumn Header="角色" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Roles}"
                                              Margin="0,4"
                                              VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource PrimaryHueLightBrush}"
                                                    CornerRadius="{DynamicResource Layout.CornerRadius.Small}"
                                                    Padding="6,2"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding}"
                                                           FontSize="12"
                                                           Foreground="White"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridCheckBoxColumn Header="启用"
                                            Binding="{Binding IsEnabled}"
                                            Width="80"/>
                    <DataGridCheckBoxColumn Header="需改密"
                                            Binding="{Binding MustChangePassword}"
                                            Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </md:Card>

        <!-- 加载遮罩 -->
        <Grid Grid.Row="0"
              Grid.RowSpan="2"
              Background="{DynamicResource Brush.Surface}"
              Opacity="0.85"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             Value="0"
                             IsIndeterminate="True"
                             Width="50"
                             Height="50"/>
                <TextBlock Text="{Binding BusyText}"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           Style="{DynamicResource TextStyle.Body}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
