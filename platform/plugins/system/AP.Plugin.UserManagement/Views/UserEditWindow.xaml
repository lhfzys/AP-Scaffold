<Window x:Class="AP.Plugin.UserManagement.Views.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="560"
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <md:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="24,20">
            <TextBlock Text="{Binding Title}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"/>
        </md:ColorZone>

        <!-- 表单 -->
        <StackPanel Grid.Row="1" Margin="32,24">
            <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                     md:HintAssist.Hint="用户名"
                     FontSize="14"
                     Margin="0,0,0,16"/>

            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                     md:HintAssist.Hint="显示名"
                     FontSize="14"
                     Margin="0,0,0,16"/>

            <PasswordBox x:Name="PasswordBox"
                         md:HintAssist.Hint="密码（编辑时留空表示不修改）"
                         FontSize="14"
                         Margin="0,0,0,16"
                         PasswordChanged="PasswordBox_PasswordChanged"/>

            <PasswordBox x:Name="ConfirmPasswordBox"
                         md:HintAssist.Hint="确认密码"
                         FontSize="14"
                         Margin="0,0,0,16"
                         PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>

            <TextBlock Text="角色"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <ListBox x:Name="RolesListBox"
                     ItemsSource="{Binding AvailableRoles}"
                     SelectionMode="Multiple"
                     BorderThickness="1"
                     BorderBrush="{DynamicResource MaterialDesignDivider}"
                     Margin="0,0,0,16"
                     Padding="8"
                     SelectionChanged="RolesListBox_SelectionChanged"/>

            <StackPanel Orientation="Horizontal">
                <CheckBox IsChecked="{Binding IsEnabled}"
                          Content="启用账号"
                          Margin="0,0,24,0"/>
                <CheckBox IsChecked="{Binding MustChangePassword}"
                          Content="首次登录强制改密"/>
            </StackPanel>
        </StackPanel>

        <!-- 底部按钮 -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource MaterialDesignCardBackground}"
                Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消"
                        Style="{StaticResource MaterialDesignPaperButton}"
                        Command="{Binding CancelCommand}"
                        Margin="0,0,12,0"/>
                <Button Content="保存"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
