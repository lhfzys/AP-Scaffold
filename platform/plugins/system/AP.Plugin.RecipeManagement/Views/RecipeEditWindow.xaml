<Window x:Class="AP.Plugin.RecipeManagement.Views.RecipeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:ui="clr-namespace:AP.Shared.UI.Behaviors;assembly=AP.Shared.UI"
        xmlns:spinner="clr-namespace:AP.Shared.UI.Controls.LoadingSpinner;assembly=AP.Shared.UI"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="620"
        Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.OnBackground}"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Outline}"
                BorderThickness="0,0,0,1"
                Padding="24,18">
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Kind="FileDocumentEdit"
                             Width="24" Height="24"
                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                             VerticalAlignment="Center"
                             Margin="0,0,12,0"/>
                <TextBlock Text="{Binding Title}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 表单 -->
        <ScrollViewer Grid.Row="1" Margin="32,24">
            <StackPanel>
                <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="配方编码"
                         FontSize="14"
                         Margin="0,0,0,16"/>

                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="配方名称"
                         FontSize="14"
                         Margin="0,0,0,16"/>

                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="配方说明"
                         FontSize="14"
                         Margin="0,0,0,16"/>

                <CheckBox IsChecked="{Binding IsEnabled}"
                          Content="启用该配方"
                          Margin="0,0,0,24"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="参数列表"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="新增参数"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding AddParameterCommand}"
                                Height="28"
                                Padding="12,0"
                                Margin="0,0,8,0"/>
                        <Button Content="删除参数"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding RemoveParameterCommand}"
                                Height="28"
                                Padding="12,0"/>
                    </StackPanel>
                </Grid>

                <DataGrid ItemsSource="{Binding Parameters}"
                          SelectedItem="{Binding SelectedParameter}"
                          CanUserAddRows="True"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource Brush.Outline}"
                          Height="220">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="参数名"
                                            Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                            Width="120"/>
                        <DataGridTextColumn Header="值"
                                            Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                            Width="120"/>
                        <DataGridTextColumn Header="单位"
                                            Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                            Width="80"/>
                        <DataGridTextColumn Header="说明"
                                            Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource Brush.Outline}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource Brush.Surface}"
                Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消"
                        Style="{StaticResource MaterialDesignPaperButton}"
                        Command="{Binding CancelCommand}"
                        Height="{DynamicResource Button.StandardHeight}"
                        Margin="0,0,12,0"/>
                <Button Content="保存"
                        Style="{StaticResource RaisedButton.Primary}"
                        Command="{Binding SaveCommand}"
                        Height="{DynamicResource Button.StandardHeight}"
                        ui:PermissionBehavior.Permission="recipe.edit"
                        ui:PermissionBehavior.HideWhenUnauthorized="False"/>
            </StackPanel>
        </Border>

        <!-- 加载遮罩 -->
        <spinner:LoadingSpinner Grid.Row="0"
                                Grid.RowSpan="3"
                                IsLoading="{Binding IsBusy}"
                                LoadingText="{Binding BusyText}"/>
    </Grid>
</Window>
