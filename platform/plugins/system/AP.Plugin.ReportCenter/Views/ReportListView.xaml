<UserControl x:Class="AP.Plugin.ReportCenter.Views.ReportListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ui="clr-namespace:AP.Shared.UI.Behaviors;assembly=AP.Shared.UI"
             xmlns:spinner="clr-namespace:AP.Shared.UI.Controls.LoadingSpinner;assembly=AP.Shared.UI"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900"
              Background="Transparent">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏卡片 -->
        <md:Card Grid.Row="0"
                 Padding="16"
                 md:ElevationAssist.Elevation="Dp1"
                 Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="报表中心"
                           Style="{DynamicResource TextStyle.Title}"
                           VerticalAlignment="Center"
                           Margin="0,0,0,16"/>

                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                    <DatePicker SelectedDate="{Binding StartDate}"
                                md:HintAssist.Hint="开始日期"
                                Width="140"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"/>

                    <DatePicker SelectedDate="{Binding EndDate}"
                                md:HintAssist.Hint="结束日期"
                                Width="140"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"/>

                    <ComboBox ItemsSource="{Binding ReportTypes}"
                              SelectedItem="{Binding SelectedReportType}"
                              DisplayMemberPath="ReportName"
                              md:HintAssist.Hint="报表类型（留空表示全部）"
                              Width="200"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"/>

                    <Button Content="查询"
                            Style="{StaticResource RaisedButton.Primary}"
                            Command="{Binding LoadArchivesCommand}"
                            Height="{DynamicResource Button.StandardHeight}"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"/>

                    <Button Content="生成今日报表"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding GenerateCommand}"
                            Height="{DynamicResource Button.StandardHeight}"
                            Margin="0,0,8,0"
                            ui:PermissionBehavior.Permission="report.export"
                            ui:PermissionBehavior.HideWhenUnauthorized="False"/>
                </WrapPanel>
            </Grid>
        </md:Card>

        <!-- 数据表格卡片 -->
        <md:Card Grid.Row="1"
                 Padding="0"
                 md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding Archives}"
                          SelectedItem="{Binding SelectedArchive}"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="报表日期"
                                            Binding="{Binding ReportDate, StringFormat=yyyy-MM-dd}"
                                            Width="100"/>
                        <DataGridTextColumn Header="报表类型"
                                            Binding="{Binding ReportType}"
                                            Width="120"/>
                        <DataGridTextColumn Header="报表名称"
                                            Binding="{Binding ReportName}"
                                            Width="160"/>
                        <DataGridTextColumn Header="记录数"
                                            Binding="{Binding RecordCount}"
                                            Width="80"/>
                        <DataGridTextColumn Header="文件大小"
                                            Binding="{Binding FileSize, Converter={StaticResource FileSizeConverter}}"
                                            Width="100"/>
                        <DataGridTextColumn Header="生成时间"
                                            Binding="{Binding GeneratedAt, StringFormat=yyyy-MM-dd HH:mm}"
                                            Width="130"/>
                        <DataGridTextColumn Header="状态"
                                            Binding="{Binding Status}"
                                            Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="0,1,0,0"
                        Background="{DynamicResource Brush.Surface}"
                        Padding="16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="打开"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding OpenCommand}"
                                Height="{DynamicResource Button.StandardHeight}"
                                Margin="0,0,12,0"
                                ui:PermissionBehavior.Permission="report.view"
                                ui:PermissionBehavior.HideWhenUnauthorized="False"/>
                        <Button Content="导出到桌面"
                                Style="{StaticResource RaisedButton.Primary}"
                                Command="{Binding ExportCommand}"
                                Height="{DynamicResource Button.StandardHeight}"
                                ui:PermissionBehavior.Permission="report.export"
                                ui:PermissionBehavior.HideWhenUnauthorized="False"/>
                    </StackPanel>
                </Border>
            </Grid>
        </md:Card>

        <!-- 加载遮罩 -->
        <spinner:LoadingSpinner Grid.Row="0"
                                Grid.RowSpan="2"
                                IsLoading="{Binding IsBusy}"
                                LoadingText="{Binding BusyText}"/>
    </Grid>
</UserControl>
