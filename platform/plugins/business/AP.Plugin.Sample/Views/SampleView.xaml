<UserControl x:Class="AP.Plugin.Sample.Views.SampleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800"
             Background="Transparent">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <md:Card Grid.Row="0" Padding="20" md:ElevationAssist.Elevation="Dp1" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="示例业务插件" Style="{DynamicResource TextStyle.Title}"/>
                <TextBlock Text="演示导航、配置、命令和报表接入；可直接复制为业务插件起点。"
                           Style="{DynamicResource TextStyle.Label}"
                           Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </md:Card>

        <md:Card Grid.Row="1" Padding="20" md:ElevationAssist.Elevation="Dp1">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Message}"
                           Style="{DynamicResource TextStyle.Title}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Count}"
                           FontSize="48"
                           HorizontalAlignment="Center"
                           Margin="0,12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="计数 +1"
                            Style="{StaticResource RaisedButton.Primary}"
                            Command="{Binding IncrementCommand}"
                            Height="{DynamicResource Button.StandardHeight}"
                            Margin="0,0,12,0"/>
                    <Button Content="重置"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding ResetCommand}"
                            Height="{DynamicResource Button.StandardHeight}"/>
                </StackPanel>
            </StackPanel>
        </md:Card>
    </Grid>
</UserControl>
