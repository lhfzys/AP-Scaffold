<UserControl x:Class="AP.Plugin.TagConfiguration.Views.TagTableListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ui="clr-namespace:AP.Shared.UI.Behaviors;assembly=AP.Shared.UI"
             xmlns:spinner="clr-namespace:AP.Shared.UI.Controls.LoadingSpinner;assembly=AP.Shared.UI"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900"
             Background="Transparent">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏卡片 -->
        <md:Card Grid.Row="0"
                 Padding="16"
                 md:ElevationAssist.Elevation="Dp1"
                 Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="点表配置"
                               Style="{DynamicResource TextStyle.Title}"/>
                    <TextBlock Text="修改后点击保存，重启应用生效"
                               Style="{DynamicResource TextStyle.Label}"
                               Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <TextBox Grid.Column="1"
                         Text="{Binding DefaultIntervalText, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="默认采集周期（毫秒）"
                         Width="180"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignToolButton}"
                            Command="{Binding RefreshCommand}"
                            ToolTip="重新从文件加载"
                            Margin="0,0,8,0">
                        <md:PackIcon Kind="Refresh" Width="22" Height="22"/>
                    </Button>
                    <Button Content="新增"
                            Style="{StaticResource RaisedButton.Primary}"
                            Command="{Binding AddTagCommand}"
                            Height="{DynamicResource Button.StandardHeight}"
                            Margin="0,0,8,0"/>
                    <Button Content="编辑"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding EditTagCommand}"
                            Height="{DynamicResource Button.StandardHeight}"
                            Margin="0,0,8,0"/>
                    <Button Content="删除"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding DeleteTagCommand}"
                            Height="{DynamicResource Button.StandardHeight}"
                            Margin="0,0,8,0"/>
                    <Button Content="保存"
                            Style="{StaticResource RaisedButton.Primary}"
                            Command="{Binding SaveCommand}"
                            Height="{DynamicResource Button.StandardHeight}"/>
                </StackPanel>
            </Grid>
        </md:Card>

        <!-- 数据表格卡片 -->
        <md:Card Grid.Row="1"
                 Padding="0"
                 md:ElevationAssist.Elevation="Dp2">
            <DataGrid ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow}"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="点名"
                                        Binding="{Binding Name}"
                                        Width="220"/>
                    <DataGridTextColumn Header="设备"
                                        Binding="{Binding DeviceId}"
                                        Width="120"/>
                    <DataGridTextColumn Header="地址"
                                        Binding="{Binding Address}"
                                        Width="130"/>
                    <DataGridTextColumn Header="类型"
                                        Binding="{Binding DataType}"
                                        Width="90"/>
                    <DataGridTextColumn Header="读写"
                                        Binding="{Binding Access}"
                                        Width="100"/>
                    <DataGridTextColumn Header="采集周期"
                                        Binding="{Binding IntervalDisplay}"
                                        Width="90"/>
                    <DataGridTextColumn Header="分组"
                                        Binding="{Binding Group}"
                                        Width="100"/>
                    <DataGridTextColumn Header="单位"
                                        Binding="{Binding Unit}"
                                        Width="70"/>
                    <DataGridTextColumn Header="描述"
                                        Binding="{Binding Description}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </md:Card>

        <!-- 加载遮罩 -->
        <spinner:LoadingSpinner Grid.Row="0"
                                Grid.RowSpan="2"
                                IsLoading="{Binding IsBusy}"
                                LoadingText="{Binding BusyText}"/>
    </Grid>
</UserControl>
