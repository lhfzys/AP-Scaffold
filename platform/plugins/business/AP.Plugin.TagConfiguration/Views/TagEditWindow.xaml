<Window x:Class="AP.Plugin.TagConfiguration.Views.TagEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="640"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.OnBackground}"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Outline}"
                BorderThickness="0,0,0,1"
                Padding="24,18">
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Kind="TableEdit"
                             Width="24" Height="24"
                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                             VerticalAlignment="Center"
                             Margin="0,0,12,0"/>
                <TextBlock Text="{Binding Title}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 表单 -->
        <ScrollViewer Grid.Row="1" Margin="32,24">
            <StackPanel>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="点名（全系统唯一，如 Line1.Oven.Temperature）"
                         FontSize="14"
                         Margin="0,0,0,16"/>

                <ComboBox ItemsSource="{Binding Devices}"
                          DisplayMemberPath="Display"
                          SelectedItem="{Binding SelectedDevice}"
                          md:HintAssist.Hint="设备"
                          FontSize="14"
                          Margin="0,0,0,16"/>

                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="协议地址（如三菱 D100 / 西门子 DB1.0.0）"
                         FontSize="14"
                         Margin="0,0,0,16"/>

                <ComboBox ItemsSource="{Binding DataTypes}"
                          SelectedItem="{Binding SelectedDataType}"
                          md:HintAssist.Hint="数据类型"
                          FontSize="14"
                          Margin="0,0,0,16"/>

                <ComboBox ItemsSource="{Binding Accesses}"
                          SelectedItem="{Binding SelectedAccess}"
                          md:HintAssist.Hint="读写方向"
                          FontSize="14"
                          Margin="0,0,0,16"/>

                <TextBox Text="{Binding IntervalOverrideText, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="采集周期覆盖 ms（留空 = 跟随默认）"
                         FontSize="14"
                         Margin="0,0,0,16"/>

                <TextBox Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="分组（可选）"
                         FontSize="14"
                         Margin="0,0,0,16"/>

                <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="工程单位（可选，如 ℃、MPa）"
                         FontSize="14"
                         Margin="0,0,0,16"/>

                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="描述（可选）"
                         FontSize="14"
                         Margin="0,0,0,16"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource Brush.Error}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource Brush.Outline}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource Brush.Surface}"
                Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消"
                        Style="{StaticResource MaterialDesignPaperButton}"
                        Command="{Binding CancelCommand}"
                        Height="{DynamicResource Button.StandardHeight}"
                        Margin="0,0,12,0"/>
                <Button Content="确定"
                        Style="{StaticResource RaisedButton.Primary}"
                        Command="{Binding SaveCommand}"
                        Height="{DynamicResource Button.StandardHeight}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
