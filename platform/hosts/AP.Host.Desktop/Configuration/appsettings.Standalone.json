{
  "AppConfiguration": {
    "CompanyName": "自动化系统",
    "SoftwareName": "自动化监控系统",
    "MachineId": "Station-01",
    "MachineName": "本机",
    "LayoutMode": "Standard",
    "DefaultNavigationTarget": "DashboardView",
    "NavigationWhenSecurityDisabled": [
      "DashboardView",
      "SettingsShellView",
      "TagTableListView",
      "RecipeListView",
      "ReportListView"
    ]
  },
  "Database": {
    "Provider": "SQLite",
    "SQLite": {
      "ConnectionString": "Data Source=local_data.db;Version=3;"
    }
  },
  "Plugins": {
    "Configuration": {
      "AP.Plugin.Scanner": {
        "Enabled": false,
        "PortName": "COM10",
        "BaudRate": 9600,
        "Parity": "None",
        "DataBits": 8,
        "StopBits": "One",
        "NewLine": "\r"
      }
    }
  }
}
