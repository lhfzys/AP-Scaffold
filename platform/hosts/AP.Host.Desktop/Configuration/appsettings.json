{
  "AppConfiguration": {
    "MachineId": "Station-01",
    "MachineName": "本机",
    "DefaultNavigationTarget": "DashboardView",
    "NavigationWhenSecurityDisabled": [
      "DashboardView",
      "SettingsShellView",
      "TagTableListView",
      "RecipeListView",
      "ReportListView"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "RetainedFileCount": 90,
    "MaxFileSizeMb": 50
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AppRole": "Standalone",
  "Plc": {
    "DriverType": "Siemens",
    "IpAddress": "127.0.0.1",
    "Port": 102,
    "Timeout": 1000,
    "Model": "S7_1200",
    "HeartbeatAddress": "DB1.0.0"
  },
  "Security": {
    "Enabled": false,
    "Audit": {
      "Enabled": true
    }
  },
  "Report": {
    "Storage": {
      "RootPath": "reports",
      "PathFormat": "{year}/{month}/{date}_{type}.xlsx",
      "DefaultTemplatePath": null
    },
    "Archive": {
      "Enabled": true,
      "Time": "02:00",
      "ReportTypes": []
    },
    "Retention": {
      "Enabled": true,
      "Days": 180,
      "CheckInterval": "1.00:00:00",
      "DeleteFiles": true,
      "ProtectedTypes": []
    },
    "Cleanup": {
      "Enabled": true,
      "DryRun": false
    }
  }
}
