{
  "AppConfiguration": {
    "MachineId": "Station-01",
    "MachineName": "一号工位电脑"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AppRole": "Standalone",
  "Report": {
    "Storage": {
      "RootPath": "reports",
      "PathFormat": "{year}/{month}/{date}_{type}.xlsx",
      "DefaultTemplatePath": null
    },
    "Archive": {
      "Enabled": true,
      "Time": "02:00",
      "ReportTypes": []
    },
    "Retention": {
      "Enabled": true,
      "Days": 180,
      "CheckInterval": "1.00:00:00",
      "DeleteFiles": true,
      "ProtectedTypes": []
    },
    "Cleanup": {
      "Enabled": true,
      "DryRun": false
    }
  }
}
