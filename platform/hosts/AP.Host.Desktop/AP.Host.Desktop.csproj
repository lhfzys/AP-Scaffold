<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- 应用图标（深蓝底白字 AP 占位图标；exe/任务栏/安装包/托盘共用） -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- 发布（方案 A：框架依赖，现场装 .NET 8 桌面运行时 + ASP.NET Core 运行时）：
         RID 与 self-contained 由发布命令行传入，避免污染日常开发构建；
         发布命令须带 -p:AppendRuntimeIdentifierToOutputPath=true，让 RID 构建落入 win-x64 子目录，不污染 bin/Release 根。
         勿开 PublishReadyToRun：R2R 与 WPF 内部混合程序集（DirectWriteForwarder）冲突，
         启动即 TypeLoadException（FixedAddressValueTypeAttribute），2026-07-29 实测踩坑。 -->
    <PublishDir>$(BuildRoot)publish\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\contracts\AP.Contracts.Hardware\AP.Contracts.Hardware.csproj" />
    <ProjectReference Include="..\..\contracts\AP.Contracts.Report\AP.Contracts.Report.csproj" />
    <ProjectReference Include="..\..\contracts\AP.Contracts.System\AP.Contracts.System.csproj" />
    <ProjectReference Include="..\..\core\AP.Core\AP.Core.csproj" />
    <ProjectReference Include="..\..\shared\AP.Shared.PluginSDK\AP.Shared.PluginSDK.csproj" />
    <ProjectReference Include="..\..\shared\AP.Shared.UI\AP.Shared.UI.csproj" />

    <ProjectReference Include="..\..\infra\AP.Infra.Database\AP.Infra.Database.csproj" />
    <ProjectReference Include="..\..\infra\AP.Infra.Logging\AP.Infra.Logging.csproj" />
    <ProjectReference Include="..\..\infra\AP.Infra.Resilience\AP.Infra.Resilience.csproj" />
    <ProjectReference Include="..\..\infra\AP.Infra.Hardware\AP.Infra.Hardware.csproj" />
    <ProjectReference Include="..\..\infra\AP.Infra.Security\AP.Infra.Security.csproj" />
    <ProjectReference Include="..\..\infra\AP.Infra.Recipe\AP.Infra.Recipe.csproj" />
    <ProjectReference Include="..\..\infra\AP.Infra.Report\AP.Infra.Report.csproj" />
    <ProjectReference Include="..\..\infra\AP.Infra.Grpc\AP.Infra.Grpc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Prism.DryIoc" />
    <PackageReference Include="DryIoc.Microsoft.DependencyInjection" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="MaterialDesignThemes" />
    <PackageReference Include="MaterialDesignColors" />
    <!-- LiveCharts2 走宿主共享库模式（同 MaterialDesign）：插件 XAML 的 BAML 引用经 Default ALC 解析，
         程序集必须在宿主输出目录；插件私有副本由 CleanDuplicateLibs 删除、PluginLoadContext 共享前缀兜底 -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Configuration\appsettings.Client.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Configuration\appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Configuration\appsettings.server.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Configuration\appsettings.Standalone.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Configuration\tags.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
